# Copy into apps/web/.env.local and apps/cms/.env.local.
# Only public credentials belong in VITE_ variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Absolute public origin, used for canonical URLs and sitemap generation.
VITE_SITE_URL=http://localhost:5173
# Optional, verified/licensed model in apps/web/public/assets/ (max 5 MB).
# VITE_HELICOPTER_MODEL_PATH=/assets/helicopter.glb
